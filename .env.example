# Railway crea DATABASE_URL automaticamente al agregar un plugin de PostgreSQL.
# En local, copia este archivo como ".env" y coloca tu propia cadena de conexion.
DATABASE_URL=postgresql://usuario:password@localhost:5432/cuentas_app

# Cambia esto por una cadena larga y aleatoria en produccion.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto local (Railway asigna el suyo propio automaticamente via PORT)
PORT=3000
